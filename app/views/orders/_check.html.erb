<fieldset data-payment-target="additionalFields" data-type="<%= pay_type.id %>">
  <div class="my-5">
    <%= form.label :routing_number, "Routing Number" %>
    <%= form.text_field :routing_number, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :account_number, "Account Number" %>
    <%= form.password_field :account_number, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
  </div>

</fieldset>