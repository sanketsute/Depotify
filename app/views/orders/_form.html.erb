<%= form_with(model: order, class: "contents") do |form| %>
  <% if order.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h2>

      <ul class="list-disc ml-6">
        <% order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:name].none?, "border-red-400 focus:outline-red-600": order.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :address %>
    <%= form.textarea :address, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:address].none?, "border-red-400 focus:outline-red-600": order.errors[:address].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :email %>
    <%= form.text_field :email, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:email].none?, "border-red-400 focus:outline-red-600": order.errors[:email].any?}] %>
  </div>
  <div class="my-5" data-controller="payment">
     <%= form.label :pay_type_id, "Payment Method" %>
      <%= form.select :pay_type_id, PayType.all.map { |pt| [pt.name, pt.id] }, {prompt: "Select Payment Method"}, 'data-payment-target'=> "selection", 'data-action'=> "payment#showAdditionalFields", class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:pay_type_id].none?, "border-red-400 focus:outline-red-600": order.errors[:pay_type_id].any?}] %>
    <% PayType.all.each do |pay_type| %>
      <%= render partial: "#{pay_type.code}", locals: { form: form, pay_type: pay_type } %>
    <% end %>
  </div>

  <div class="inline">
    <%= form.submit 'Place Order', class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
