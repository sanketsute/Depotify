<fieldset data-payment-target="additionalFields" data-type="Credit card">
  <div class="my-5">
    <%= form.label :credit_card_number, "Credit Card Number" %>
    <%= form.text_field :credit_card_number, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :expiration_date, "Expiration Date" %>
    <%= form.text_field :expiration_date, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", placeholder: "e.g. MM/YY", size: 9 %>
  </div>

</fieldset>